ring Audit=(0,j),(w7,w6,w5,w4,w3,w2,w1,w0),Dp;
minpoly=j^2+1;
option(redSB);
matrix M[7][13]=-2*w2,-2*w0 - 6*j*w7,0,-2*j*w4 - 2*w5,-2*w0 - 2*w6 - 2*j*w7,0,0,0,2*w6 - 4*j*w7,-2*w2 - 2*j*w4 - 2*w5,-2*j*w6 - 4*w7,-4*w4 + 4*j*w5,2*j*w6 + 4*w7,
4*w0 - 2*w1 + 12*j*w7,-2*w2 - 2*j*w4,-4*j*w2 + 2*w4,2*w0 + 2*w3 + 2*w6 + 2*j*w7,-2*w2 - 2*j*w4 - 4*w5,0,2*w6 - 4*j*w7,-6*w2 - 4*j*w4 - 2*w5,2*w2 + 2*w5,-2*w0 - 2*w1 + 2*w3 - 6*j*w7,-4*j*w2 + 2*w4 - 4*j*w5,-4*j*w3 - 4*j*w6 - 8*w7,4*j*w5,
-2*j*w2,-2*j*w0 + 6*w7,0,2*w4 - 2*j*w5,-2*j*w0 - 2*j*w6 + 2*w7,0,0,0,2*j*w6 + 4*w7,-2*j*w2 + 2*w4 - 2*j*w5,2*w6 - 4*j*w7,-4*j*w4 - 4*w5,-2*w6 + 4*j*w7,
2*j*w0 - 2*j*w1 - 6*w7,-2*j*w2 + 2*w4,2*w2 - 2*w5,2*j*w3,-2*j*w2 + 2*w4 - 4*j*w5,0,2*j*w6 + 4*w7,-4*j*w2 + 2*w4,2*w4,-2*j*w0 - 2*j*w1 + 2*j*w3 + 6*w7,2*w2 + 2*w5,4*w3 + 2*w6 - 4*j*w7,-4*w5,
-2*j*w2 + 2*w4,0,-2*w1 + 2*w3 + 2*w6 - 4*j*w7,-2*j*w2 + 2*w4 - 4*j*w5,0,w6 - 2*j*w7,-2*j*w2 + 2*w4 - 2*j*w5,2*j*w1 - 2*j*w3 - 2*j*w6 - 4*w7,-2*j*w0 - 2*j*w1 + 2*j*w3 + 6*w7,0,-2*w1 + 2*w3 + w6 - 2*j*w7,-4*w5,0,
2*w7,0,2*w5,2*j*w6 + 2*w7,0,2*w5,-2*j*w1 + 2*j*w3 + 2*j*w6 + 4*w7,-2*j*w5,-2*j*w2 + 2*w4 - 2*j*w5,0,0,2*w6,0,
0,0,0,0,0,-w6,2*j*w5,0,2*j*w6 + 2*w7,0,w6,0,0;
ideal J=minor(M,3);
print("Computing reverse-variable degree-lex standard basis");
ideal G=std(J);
print("INDEPENDENT_AFFINE_DIMENSION"); dim(G);
print("BASIS_SIZE"); size(G);
link output="ASCII:w recursive_normal_rank2_independent_leading.txt";
for(int k=1;k<=size(G);k++){write(output,string(lead(G[k])));}
close(output);
quit;
